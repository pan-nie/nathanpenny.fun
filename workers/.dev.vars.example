# Sample local-dev vars for `npx wrangler dev` (copy to workers/.dev.vars —
# that file is gitignored and must NEVER be committed or present at deploy).
# ADMIN_BYPASS=1 skips Cloudflare Access JWT verification on /admin,
# /upload and /admin/api/* so the admin page can be tested locally. The
# deployed Worker must never have this var; Access JWT verification is the
# only gate there.
ADMIN_BYPASS=1

# Optional: salt for the analytics visitor hash (visitor_id = sha256(salt+IP+UA)).
# Without it ingest still works with an empty salt; production sets the real
# secret:  npx wrangler secret put ANALYTICS_SALT
ANALYTICS_SALT=dev-salt-not-for-production

# Optional: Cloudflare API token (Workers AI scope) for local testing of the
# AI proxy's cf-* models. Also needs the CF_ACCOUNT_ID var, which is already
# in wrangler.jsonc.
# CF_AI_TOKEN=...

# Optional: GitHub fine-grained PAT (repo pan-nie/nathanpenny.fun,
# Contents: Read and write) for local testing of the 写作台 editor API.
# GITHUB_TOKEN=github_pat_...
